{
  "name": "fullstack-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:storybook": "turbo run build-storybook --filter=@fullstack-template/storybook",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "dev": "turbo run dev --parallel",
    "dev:convex": "pnpm --filter @fullstack-template/frontend convex:dev",
    "dev:frontend": "pnpm --filter @fullstack-template/frontend dev",
    "dev:storybook": "pnpm --filter @fullstack-template/storybook storybook",
    "format": "biome check --write .",
    "lint": "turbo run lint",
    "prepare": "husky",
    "secrets:staged": "gitleaks git --staged --redact .",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @fullstack-template/frontend test:e2e",
    "test:e2e:docker": "pnpm --filter @fullstack-template/frontend test:e2e:docker",
    "test:e2e:headed": "pnpm --filter @fullstack-template/frontend test:e2e:headed",
    "typecheck": "turbo run typecheck",
    "worktree:cleanup": "./scripts/worktree-cleanup.sh",
    "worktree:create": "./scripts/worktree-create.sh",
    "worktree:setup": "./scripts/worktree-setup.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "turbo": "2.9.6",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
